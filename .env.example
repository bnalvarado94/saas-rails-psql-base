# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=saas_rails_psql_base

# DATABASE_URL — usado directamente por database.yml en todos los entornos.
# Con Docker se construye automáticamente a partir de las vars de arriba.
# Para dev local sin Docker, descomenta y ajusta:
# DATABASE_URL=postgresql://postgres:password@localhost/saas_rails_psql_base_development

# Rails
RAILS_ENV=development
SECRET_KEY_BASE=your_secret_key_base_here
RAILS_LOG_TO_STDOUT=true

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting (requests per 5 minutes per IP)
RACK_ATTACK_LIMIT=300

# JWT
JWT_SECRET=your_jwt_secret_here

# Puma
WEB_CONCURRENCY=2
RAILS_MAX_THREADS=5
