#!/bin/bash -e

# Purpose: Docker entrypoint for both production and development containers.
# Order matters: gems must be present before Rails (db:prepare) loads.

# Remove stale server PID file (common after unclean container shutdown)
rm -f tmp/pids/server.pid

# Run db:prepare before starting any Rails process.
# db:prepare is idempotent: creates DB if missing, runs pending migrations.
./bin/rails db:prepare

# Load the Solid Queue schema if its tables don't exist yet.
# db/queue_schema.rb is a separate schema file (not loaded by db:prepare).
# The table_exists? guard makes this idempotent across restarts.
./bin/rails runner "
  unless ActiveRecord::Base.connection.table_exists?('solid_queue_jobs')
    puts 'Loading Solid Queue schema...'
    load Rails.root.join('db/queue_schema.rb').to_s
  end
"

exec "${@}"
